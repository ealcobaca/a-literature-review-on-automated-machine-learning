@article{ WOS:001081558700001,
Author = {Ng, K. W. and Huang, Y. F. and Koo, C. H. and Chong, K. L. and
   El-Shafie, Ahmed and Ahmed, Ali Najah},
Title = {A review of hybrid deep learning applications for streamflow forecasting},
Journal = {JOURNAL OF HYDROLOGY},
