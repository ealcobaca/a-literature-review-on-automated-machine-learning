	affiliations = {Key Laboratory for Ubiquitous Network and Service Software of Liaoning Province, Liaoning, Dalian, 116024, China; Peng Cheng Laboratory, Guangdong, Shenzhen, 518066, China; Dalian University of Technology, DUT-RU International School of Information Science & Engineering, Liaoning, Dalian, 116024, China; Southern University of Science and Technology, Department of Mathematics, Guangdong, Shenzhen, 518055, China; National Center for Applied Mathematics Shenzhen, Guangdong, Shenzhen, 518055, China; Macau University of Science and Technology, Faculty of Information Technology, Taipa, 999078, Macao; Peking University, Key Laboratory of Machine Perception (Ministry of Education), School of Artificial Intelligence, Beijing, 100871, China},
	abstract = {Bi-Level Optimization (BLO) is originated from the area of economic game theory and then introduced into the optimization community. BLO is able to handle problems with a hierarchical structure, involving two levels of optimization tasks, where one task is nested inside the other. In machine learning and computer vision fields, despite the different motivations and mechanisms, a lot of complex problems, such as hyper-parameter optimization, multi-task and meta learning, neural architecture search, adversarial learning and deep reinforcement learning, actually all contain a series of closely related subproblms. In this paper, we first uniformly express these complex learning and vision problems from the perspective of BLO. Then we construct a best-response-based single-level reformulation and establish a unified algorithmic framework to understand and formulate mainstream gradient-based BLO methodologies, covering aspects ranging from fundamental automatic differentiation schemes to various accelerations, simplifications, extensions and their convergence and complexity properties. Last but not least, we discuss the potentials of our unified BLO framework for designing new algorithms and point out some promising directions for future research. A list of important papers discussed in this survey, corresponding codes, and additional resources on BLOs are publicly available at: https://github.com/vis-opt-group/BLO.  © 1979-2012 IEEE.},
	author_keywords = {Best-response mapping; Bi-level optimization; Explicit and implicit gradients; Learning and vision applications; Value-function-based reformulation},
	keywords = {Computer vision; Deep learning; Game theory; Best response; Best-response mapping; Bi-level optimization; Complexity theory; Convergence; Explicit and implicit gradient; Implicit gradient; Learning and vision application; Optimisations; Reinforcement learnings; Task analysis; Value functions; Value-function-based reformulation; Vision applications; acceleration; algorithm; article; learning; vision; Reinforcement learning},
	correspondence_address = {Z. Lin; Peng Cheng Laboratory, Shenzhen, Guangdong, 518066, China; email: zlin@pku.edu.cn},
