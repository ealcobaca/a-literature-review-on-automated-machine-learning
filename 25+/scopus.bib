@ARTICLE{Hancock2020,
	author = {Hancock, John T. and Khoshgoftaar, Taghi M.},
	title = {CatBoost for big data: an interdisciplinary review},
	year = {2020},
	journal = {Journal of Big Data},
	volume = {7},
	number = {1},
	doi = {10.1186/s40537-020-00369-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85095133488&doi=10.1186%2fs40537-020-00369-8&partnerID=40&md5=2feb6d0d6316e93e3f9efd0792f11a85},
	affiliations = {Florida Atlantic University, 777 Glades Road, Boca Raton, FL, United States},
	abstract = {Gradient Boosted Decision Trees (GBDT’s) are a powerful tool for classification and regression tasks in Big Data. Researchers should be familiar with the strengths and weaknesses of current implementations of GBDT’s in order to use them effectively and make successful contributions. CatBoost is a member of the family of GBDT machine learning ensemble techniques. Since its debut in late 2018, researchers have successfully used CatBoost for machine learning studies involving Big Data. We take this opportunity to review recent research on CatBoost as it relates to Big Data, and learn best practices from studies that cast CatBoost in a positive light, as well as studies where CatBoost does not outshine other techniques, since we can learn lessons from both types of scenarios. Furthermore, as a Decision Tree based algorithm, CatBoost is well-suited to machine learning tasks involving categorical, heterogeneous data. Recent work across multiple disciplines illustrates CatBoost’s effectiveness and shortcomings in classification and regression tasks. Another important issue we expose in literature on CatBoost is its sensitivity to hyper-parameters and the importance of hyper-parameter tuning. One contribution we make is to take an interdisciplinary approach to cover studies related to CatBoost in a single work. This provides researchers an in-depth understanding to help clarify proper application of CatBoost in solving problems. To the best of our knowledge, this is the first survey that studies all works related to CatBoost in a single publication. © 2020, The Author(s).},
	author_keywords = {Big data; CatBoost; Categorical variable encoding; Decision tree; Ensemble methods; Machine learning},
	keywords = {Big data; Machine learning; Signal encoding; 'current; Boosted decision trees; Catboost; Categorical variable encoding; Categorical variables; Encodings; Ensemble methods; Hyper-parameter; Learn+; Machine-learning; Decision trees},
	correspondence_address = {J.T. Hancock; Florida Atlantic University, Boca Raton, 777 Glades Road, United States; email: jhancoc4@fau.edu},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {21961115},
	language = {English},
	abbrev_source_title = {J. Big Data},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 797; All Open Access, Gold Open Access, Green Open Access}
}

@ARTICLE{Lotte2018,
	author = {Lotte, F. and Bougrain, L. and Cichocki, A. and Clerc, M. and Congedo, M. and Rakotomamonjy, A. and Yger, F.},
	title = {A review of classification algorithms for EEG-based brain-computer interfaces: A 10 year update},
	year = {2018},
	journal = {Journal of Neural Engineering},
	volume = {15},
	number = {3},
	doi = {10.1088/1741-2552/aab2f2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85040605067&doi=10.1088%2f1741-2552%2faab2f2&partnerID=40&md5=f6799b654bd96c7310dde233bdeb459a},
	affiliations = {Inria, LaBRI (CNRS/Univ. Bordeaux /INP), Talence, France; RIKEN Brain Science Insitute, Wakoshi, Japan; Univ. Lorraine, Nancy, France; Inria Nancy Grand-Est, LORIA, Nancy, France; Skolkowo Institute of Science and Technology, Moscow, Russian Federation; Inria, Université Côte d'Azur, France; Univ. Grenoble Alpes, CNRS, Grenoble INP, GIPSA-lab, Grenoble, France; Univ. Rouen, LITIS, Rouen, France; Univ. Paris-Dauphine, PSL Research Univ., CNRS, LAMSADE, Paris, France; Nicolaus Copernicus University, Torun, Poland},
	abstract = {Objective. Most current electroencephalography (EEG)-based brain-computer interfaces (BCIs) are based on machine learning algorithms. There is a large diversity of classifier types that are used in this field, as described in our 2007 review paper. Now, approximately ten years after this review publication, many new algorithms have been developed and tested to classify EEG signals in BCIs. The time is therefore ripe for an updated review of EEG classification algorithms for BCIs. Approach. We surveyed the BCI and machine learning literature from 2007 to 2017 to identify the new classification approaches that have been investigated to design BCIs. We synthesize these studies in order to present such algorithms, to report how they were used for BCIs, what were the outcomes, and to identify their pros and cons. Main results. We found that the recently designed classification algorithms for EEG-based BCIs can be divided into four main categories: adaptive classifiers, matrix and tensor classifiers, transfer learning and deep learning, plus a few other miscellaneous classifiers. Among these, adaptive classifiers were demonstrated to be generally superior to static ones, even with unsupervised adaptation. Transfer learning can also prove useful although the benefits of transfer learning remain unpredictable. Riemannian geometry-based methods have reached state-of-the-art performances on multiple BCI problems and deserve to be explored more thoroughly, along with tensor-based methods. Shrinkage linear discriminant analysis and random forests also appear particularly useful for small training samples settings. On the other hand, deep learning methods have not yet shown convincing improvement over state-of-the-art BCI methods. Significance. This paper provides a comprehensive overview of the modern classification algorithms used in EEG-based BCIs, presents the principles of these methods and guidelines on when and how to use them. It also identifies a number of challenges to further advance EEG classification in BCI. © 2018 IOP Publishing Ltd.},
	author_keywords = {brain-computer interfaces; classification; deep learning; electroencephalography; Riemannian geometry; spatial filtering; transfer learning},
	keywords = {Algorithms; Animals; Brain; Brain-Computer Interfaces; Deep Learning; Electroencephalography; Humans; Signal Processing, Computer-Assisted; Time Factors; Artificial intelligence; Classification (of information); Decision trees; Deep learning; Discriminant analysis; Electroencephalography; Electrophysiology; Geometry; Interfaces (computer); Learning algorithms; Tensors; Brain computer interfaces (BCIs); Diversity of classifiers; Linear discriminant analysis; Machine learning literature; Riemannian geometry; Spatial filterings; State-of-the-art performance; Transfer learning; brain computer interface; classification algorithm; classifier; deep learning; electroencephalography; feature extraction; feature selection; geometry; human; machine learning; pattern recognition; practice guideline; priority journal; random forest; Review; shrinkage linear discriminant analysis; signal processing; supervised machine learning; task performance; transfer of learning; unsupervised machine learning; algorithm; animal; brain; brain computer interface; electroencephalography; physiology; procedures; signal processing; time factor; Brain computer interface},
	publisher = {Institute of Physics Publishing},
	issn = {17412560},
	pmid = {29488902},
	language = {English},
	abbrev_source_title = {J. Neural Eng.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1532; All Open Access, Bronze Open Access, Green Open Access}
}

