@article{ WOS:001025399200001,
Author = {Nguyen, Van Giao and Duong, Xuan Quang and Nguyen, Lan Huong and Nguyen,
   Phuoc Quy Phong and Priya, Jayabal Chandra and Truong, Thanh Hai and Le,
