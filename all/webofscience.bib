@article{ WOS:000705940500001,
Author = {Caramiaux, Baptiste and Francoise, Jules and Liu, Wanyu and Sanchez, Teo
   and Bevilacqua, Frederic},
Title = {Machine Learning Approaches for Motor Learning: A Short Review},
Journal = {FRONTIERS IN COMPUTER SCIENCE},
Year = {2020},
Volume = {2},
Month = {MAY 29},
Abstract = {Machine learning approaches have seen a considerable number of
   applications in human movement modeling but remain limited for motor
   learning. Motor learning requires that motor variability be taken into
   account and poses new challenges because the algorithms need to be able
   to differentiate between new movements and variation in known ones. In
   this short review, we outline existing machine learning models for motor
   learning and their adaptation capabilities. We identify and describe
   three types of adaptation: Parameter adaptation in probabilistic models,
   Transfer and meta-learning in deep neural networks, and Planning
   adaptation by reinforcement learning. To conclude, we discuss challenges
   for applying these models in the domain of motor learning support
   systems.},
