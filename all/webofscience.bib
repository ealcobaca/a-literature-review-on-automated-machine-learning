@article{ WOS:001190136500003,
Author = {Kalkeseetharaman, P. K. and George, S. Thomas},
Title = {A Bird's Eye View Approach on the Usage of Deep Learning Methods in Lung
   Cancer Detection and Future Directions Using X-Ray and CT Images},
