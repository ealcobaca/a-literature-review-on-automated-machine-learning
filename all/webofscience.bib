@article{ WOS:001383396300001,
Author = {Wang, Yu and Cao, Yan and Qu, Xuanren and Wang, Miao and Wang, Youliang
   and Zhang, Cheng},
Title = {A review of the application of machine learning techniques in thermal
   error compensation for CNC machine tools},
Journal = {MEASUREMENT},
Year = {2025},
Volume = {243},
Month = {FEB 15},
Abstract = {Thermal error is a key factor that affects the overall error of CNC
   machine tools and the machining accuracy of workpieces. Effectively
   addressing the impact of thermal errors has been a widely researched
   topic in the field of mechanical machining. With the continuous
   development of machine learning (ML) technology, an increasing number of
   ML algorithms are being used to improve the compensation accuracy of
   thermal errors. This paper reviews some methods for addressing thermal
   errors. It provides a comprehensive overview of one of the main
   strategies for solving thermal errors: the compensation method. It
   focuses on the data- driven compensation methods (DDMs) using ML
   algorithms. And special attention is given to the redundancy and
   collinearity issues encountered when using temperature data extensively.
   The paper summarizes the methods for selecting temperature-sensitive
   points (TSPs) in recent years, such as correlation analysis, ML based
   selection methods. And this paper categorizes five types of ML
   techniques used for thermal error compensation, including traditional
   machine learning, ensemble learning, deep learning, transfer learning,
   and adaptive strategies. Furthermore, this paper further analyzes the
   advantages and limitations of these different methods in the context of
   thermal error compensation. Finally, based on the current research
   status, the paper proposes directions and challenges for further
   research.},
