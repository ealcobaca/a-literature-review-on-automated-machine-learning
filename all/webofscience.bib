   Ajith, S.; Debnath, Manoj Kanti, Uttar Banga Krishi Viswavidyalaya, Dept Agr Stat, Cooch Behar, India.},
DOI = {10.1007/s00484-024-02763-w},
EarlyAccessDate = {AUG 2024},
ISSN = {0020-7128},
EISSN = {1432-1254},
Keywords = {Yield prediction; Penalized regression models; Artificial Neural
   Network; Support Vector Regression; Hyperparameter Optimization; Partial
   Least Square Regression},
