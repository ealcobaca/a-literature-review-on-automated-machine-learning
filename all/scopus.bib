	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001671491&doi=10.1109%2fSNAMS64316.2024.10883797&partnerID=40&md5=366a3447ef65b4aeb922eacae90bd16f},
	affiliations = {University of Staffordshire, Department of Computing and Esports, Stoke-On-Trent, United Kingdom},
	abstract = {this research investigates the use of transfer learning models, particularly BERT and LLaMA, for sentiment polarity classification in retail product reviews. Traditional machine learning techniques such as Naïve Bayes and SVM have struggled to capture nuanced linguistic patterns, including sarcasm, idiomatic expressions, and contextual shifts, due to their reliance on surface-level features and large labeled datasets. BERT and LLaMA, leveraging pre-Trained large language models, overcome these limitations by capturing deep contextual relationships and subtle language patterns with minimal manual feature engineering. BERT's bidirectional attention mechanism allows it to interpret sentiment by analyzing both the preceding and following words in a sentence, making it highly effective at detecting complex linguistic phenomena. LLaMA, optimized with quantization and Low-Rank Adaptation (LoRA), offers computational efficiency while maintaining high performance, making it suitable for resource-constrained environments or real-Time applications. This study fine-Tunes both models on retail-specific datasets to enhance their ability to detect sentiment polarity, thereby providing more accurate and scalable solutions for businesses looking to understand customer feedback. Through model comparison, BERT and LLaMA outperform traditional methods in terms of accuracy and efficiency, particularly in handling complex language structures. This research demonstrates the potential of these models to transform sentiment analysis in retail, leading to more informed decision-making and improved customer satisfaction. © 2024 IEEE.},
