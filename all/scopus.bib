	doi = {10.1109/ICETST55735.2022.9922944},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141443780&doi=10.1109%2fICETST55735.2022.9922944&partnerID=40&md5=756b7f55e8b74a47e999c6d235f987d7},
	affiliations = {University of the Punjab, Faculty of Computing and Information Technology, Department of Computer Science, Lahore, Pakistan; University of the Punjab, Faculty of Computing and Information Technology, Department of Data Science, Lahore, Pakistan},
	abstract = {Executing medical diagnoses appropriately and effectively is critical due to the scarcity of available resources in the hospitals of developing countries. Diagnosis is also rendered by professional practice and expertise. Because of this, patients bear unnecessary and disproportionate care costs. The automated system is very beneficial for medical diagnosis. As in some cases, there could be a shortage of resource personnel, and not all doctors have experience in subspecialties. We needed studies of various available techniques and their comparisons for implementing these accurate automated systems. The current research, however, is an alternative precaution to this issue. A preliminary indication of cardiovascular disease using a predictive model is essential as it reduces the risk of developing the disease. The likelihood of having the cardiovascular disease can be predicted using multiple factors. One thousand sixty samples of individuals were taken from different hospitals in Punjab by using a questionnaire survey. Other scaling techniques were applied to the collected data. Various machine learning algorithms with hyperparameter tuning were applied to the collected data. As the results of the predictions were satisfactory, it would help predict cardiovascular disease and act as a critical public awareness to avoid future cardiac disease.  © 2022 IEEE.},
	author_keywords = {Cardiovascular disease; KNN; Random Forest; SVM},
