	publisher = {Elsevier Ltd},
	issn = {2214367X},
	language = {English},
	abbrev_source_title = {Travel Behav. Soc.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 23}
}

