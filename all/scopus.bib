@ARTICLE{Pawlicki20221075,
	author = {Pawlicki, Marek and Kozik, Rafał and Choraś, Michał},
	title = {A survey on neural networks for (cyber-) security and (cyber-) security of neural networks},
	year = {2022},
	journal = {Neurocomputing},
	volume = {500},
	pages = {1075 – 1087},
	doi = {10.1016/j.neucom.2022.06.002},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131781387&doi=10.1016%2fj.neucom.2022.06.002&partnerID=40&md5=e93624fe47521c65b082a17a50432665},
	affiliations = {ITTI Sp. z o.o., Poznan, Poland; Bydgoszcz University of Science and Technology, Poland; FernUniversitat in Hagen (FUH), Germany},
	abstract = {The goal of this systematic and broad survey is to present and discuss the main challenges that are posed by the implementation of Artificial Intelligence and Machine Learning in the form of Artificial Neural Networks in Cybersecurity, specifically in Intrusion Detection Systems. Based on the results of the state-of-the-art analysis with a number of bibliographic methods, as well as their own implementations, the authors provide a survey of the answers to the posed problems as well as effective, experimentally-found solutions to those key issues. The issues include hyperparameter tuning, dataset balancing, increasing the effectiveness of an ANN, securing the networks from adversarial attacks, and a range of non-technical challenges of applying ANNs for IDS, such as societal, ethical and legal dilemmas, and the question of explainability. Thus, it is a systematic review and a summary of the body of knowledge amassed around implementations of Artificial Neural Networks in Network Intrusion Detection, guided by an actual, real-world implementation. © 2022 The Author(s)},
