}@CONFERENCE{Wang20203569,
	author = {Wang, Ruoying and Nie, Kexin and Chang, Yen-Jung and Gong, Xinwei and Wang, Tie and Yang, Yang and Long, Bo},
	title = {Deep Learning for Anomaly Detection},
