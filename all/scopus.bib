	title = {Research on the Impact of Social Presence, Academic Self-efficacy, and Flow Experience on Students' Learning Engagement in Blended Synchronous Learning},
	year = {2024},
	journal = {Proceedings - 2024 International Symposium on Educational Technology, ISET 2024},
	pages = {235 – 239},
	doi = {10.1109/ISET61814.2024.00053},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206578946&doi=10.1109%2fISET61814.2024.00053&partnerID=40&md5=a35b740d6029f046ecbe14e607bd2dcc},
	affiliations = {Jianghan University, School of Education, Wuhan, China; Central China Normal University, Faculty of Artificial Intelligence in Education, Wuhan, China; State University of New York at Oswego, School of Education, Oswego, United States},
	abstract = {Blended synchronous learning combines traditional face-to-face teaching and online learning, aiming to provide a flexible and diversified learning experience and enhance the learning effect of students. The purpose of this study is to explore how students' social presence, academic self-efficacy, and flow experience affect students' learning engagement in the blended synchronous learning environment. Through literature review and comprehensive analysis, research has found that social presence, academic self-efficacy, and flow experience have a significant direct impact on students' learning engagement. In addition, social presence has an indirect promoting effect on students' learning engagement through academic self-efficacy and flow experience. This study provides theoretical support and practical guidance for the teaching practice of blended synchronous classrooms, which helps improve students' learning experience and effect.  © 2024 IEEE.},
	author_keywords = {academic self-efficacy; blended synchronous learning; flow experience; learning engagement; social presence},
	keywords = {Active learning; Adversarial machine learning; Collaborative learning; Contrastive Learning; Self-supervised learning; Social psychology; Transfer learning; Academic self-efficacy; Blended synchronous learning; Face to face; Flow experience; Learning effects; Learning engagement; Social presence; Student learning; Synchronous learning; Teaching-learning; Federated learning},
	correspondence_address = {Y. Shi; Central China Normal University, Faculty of Artificial Intelligence in Education, Wuhan, China; email: yhshi@ccnu.edu.cn; H.H. Yang; Central China Normal University, Faculty of Artificial Intelligence in Education, Wuhan, China; email: harrison.yang@oswego.edu},
	editor = {Chui K.T. and Hui Y.K. and Yang D. and Lee L.-K. and Wong L.-P. and Reynolds B.L.},
