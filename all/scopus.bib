@BOOK{Mitchell202495,
	author = {Mitchell, Benjamin R. and Cohen, Marion C. and Cohen, Stanley},
	title = {Artificial intelligence in pathology: Easing the burden of annotation},
	year = {2024},
	journal = {Artificial Intelligence in Pathology: Principles and Applications, Second Edition},
	pages = {95 – 108},
	doi = {10.1016/B978-0-323-95359-7.00006-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213193014&doi=10.1016%2fB978-0-323-95359-7.00006-6&partnerID=40&md5=15286d365e7099d422620cb565e80ebb},
	affiliations = {Department of Computer Science, Swarthmore College, Swarthmore, PA, United States; CSAI, PA, United States; Perelman Medical School, University of Pennsylvania, Philadelphia, PA, United States; Kimmel School of Medicine, Jefferson University, Philadelphia, PA, United States},
	abstract = {It has become clear that the need for huge datasets represents a bottleneck for applications of artificial intelligence classes. In pathology, there is the additional problem that there are often substantially fewer annotated target lesions than normal tissues for comparison. While deep learning algorithms have successfully tackled problems previously thought to be solely the domain of humans, this dependence on massive amounts of data is one of the major ways in which computer models of the brain are deficient. Organic brains utilize large numbers of specialized neural nets arranged in both linear and parallel fashion, with each solving a restricted classification problem. They rely on local error corrections such as Hebbian learning (“neurons that fire together wire together”) as compared to the nonlocal back-propagation used in most implementations of artificial neural nets. They incorporate reinforcement into their learning strategy. For these reasons, even toddlers can easily classify objects after one or only a few examples. Rather than provide an overview of current research articles on artificial intelligence in the pathology literature, this review will focus on general strategies for dealing with the huge datasets that we routinely encounter. These include transfer learning, zero-shot learning, Siamese networks, one-class models, generative networks, and reinforcement learning. Neither an extensive mathematical background nor advanced programming skills are needed in order to make these subjects accessible to pathologists with limited background in the nuts and bolts of machine learning. However, some familiarity with the basic principles of deep learning is necessary. In chapter 4 we provide a detailed description of these approaches. In this chapter we show how they are used to ameliorate training data needs. By providing an overview and extension of these concepts, this material will help to understand some of the current limitations of machine learning and how to address these. We begin with classical approaches and then move on to newer methodologies. © 2025 Elsevier Inc. All rights reserved.},
	author_keywords = {Generative networks; One-glass models; Reinforcement learning; Siamese netwroks; Transfer learning; Zero-shot earning},
	publisher = {Elsevier},
	isbn = {978-032395359-7; 978-032395832-5},
	language = {English},
	abbrev_source_title = {Artificial Intelligence in Pathology: Principles and Applications, Second Edition},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

