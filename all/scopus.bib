	pages = {13 – 25},
	doi = {10.1007/978-3-031-01575-5_2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141896657&doi=10.1007%2f978-3-031-01575-5_2&partnerID=40&md5=a65a0426598543c27f8af1b3e398fca2},
	affiliations = {Google, Inc., United States; University of Illinois, Chicago, United States},
	abstract = {As described in the introduction chapter, lifelong machine learning (LML) (or simply lifelong learning) has three key characteristics: continuous learning process, explicit knowledge retention and accumulation, and the use of the previously learned knowledge to help new learning tasks. There are several machine learning paradigms that have related characteristics. This chapter discusses the most related ones, i.e., transfer learning or domain adaption, multi-task learning, online learning, and reinforcement learning. The first two paradigms are more closely related to LML because they both involve some kind of knowledge transfer across domains or tasks, but they don't learn continuously and don't retain or accumulate learned knowledge explicitly. Online learning and reinforcement learning involves continuous learning processes but they focus on the same learning task with a time dimension. These differences will become clearer after we review some representative techniques for each of these related learning paradigms. © 2017, Springer Nature Switzerland AG.},
	keywords = {E-learning; Knowledge management; Continuous learning; Explicit knowledge; Key characteristics; Learning paradigms; Learning process; Learning tasks; Life long learning; Machine-learning; Online learning; Reinforcement learnings; Reinforcement learning},
	publisher = {Springer Nature},
