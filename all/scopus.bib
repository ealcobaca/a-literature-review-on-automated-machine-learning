	journal = {Proceedings - 2024 International of Seminar on Application for Technology of Information and Communication: Smart And Emerging Technology for a  Better Life, iSemantic 2024},
	pages = {445 – 450},
	doi = {10.1109/iSemantic63362.2024.10762109},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213316796&doi=10.1109%2fiSemantic63362.2024.10762109&partnerID=40&md5=1d3e84a819088f882b657e23ef107365},
	affiliations = {Universitas Dian Nuswantoro, Faculty of Computer Science, Semarang, Indonesia; Universitas Islam Kalimantan M A B, Faculty of Information Technology, Banjarmasin, Indonesia},
	abstract = {The prevalence of large-scale dental disease in humans affects their health by making them unable to perform basic tasks with their mouth. Around 3.5 billion people worldwide are affected by dental and oral diseases, mostly in low- and middle-income countries. Due to the high cost of such a diagnosis and treatment, there are no adequate dental and oral health services. Utilizing rapid and dependable methods for early diagnosis of dental disease will be extremely beneficial in resolving this issue. An active area of research is identifying dental diseases from digital camera images. Various machine learning algorithms and the use of convolutional neural networks (CNN) have improved the accuracy of dental disease classification. A dental disease detection and classification system based on computer vision and dental disease photos will be crucial in this setting. Although a number of methods are currently used on an ad hoc basis to identify and classify dental diseases, there have been few systematic studies done to examine how well these methods work with real-world data on dental diseases. This study aim to assess the exhibitions of different CNN-based move learning structures, for example, the ResNet50V2, EfficientNetV0B0 and The Oral Disease Dataset, the Oral Infection Dataset, and the Teeth Dataset were the three publicly accessible databases on which the models were tested. Metrics performances such as, Accuracy, Review, F1 score and in general exactness were utilized to assess the end-product of the examination, which uncovered that ResNet50V2 showed the most elevated precision of 82%, 82.5% and 81.6% on the three datasets, separately, beating any remaining cutting edge models like EfficientNetV1B0 and EfficientNetV2B0. © 2024 IEEE.},
	author_keywords = {CNN; dental detection; oral disease; transfer learning},
	keywords = {Adversarial machine learning; Contrastive Learning; Diagnosis; Transfer learning; Comparative performance; Convolutional neural network; Dental detection; Disease classification; Large-scales; Learning models; Low income countries; Network-based; Oral disease; Transfer learning; Convolutional neural networks},
	correspondence_address = {Y. Ikhwani; Universitas Dian Nuswantoro, Faculty of Computer Science, Semarang, Indonesia; email: p41202300066@mhs.dinus.ac.id},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-835036664-8},
	language = {English},
	abbrev_source_title = {Proc. - Int. Semin. Appl. Technol. Inf. Commun.: Smart Emerg. Technol. Better Life, iSemantic},
	type = {Conference paper},
	publication_stage = {Final},
