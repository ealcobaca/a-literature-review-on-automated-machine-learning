	keywords = {brain tumor; computer assisted tomography; convolutional neural network; data processing; diagnostic imaging; fluid-attenuated inversion recovery imaging; human; image segmentation; machine learning; natural language processing; nuclear magnetic resonance imaging; Preferred Reporting Items for Systematic Reviews and Meta-Analyses; publication; Review; systematic review},
	correspondence_address = {A. Wang; Auckland Bioengineering Institute, The University of Auckland, Auckland, New Zealand; email: alan.wang@auckland.ac.nz},
