@ARTICLE{Kamran2022,
	author = {Kamran, Hootan and Aleman, Dionne M. and McIntosh, Chris and Purdie, Thomas G.},
	title = {SuPART: Supervised projective adapted resonance theory for automatic quality assurance approval of radiotherapy treatment plans},
	year = {2022},
	journal = {Physics in Medicine and Biology},
	volume = {67},
	number = {6},
	doi = {10.1088/1361-6560/ac568f},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85126720261&doi=10.1088%2f1361-6560%2fac568f&partnerID=40&md5=048ec952548c47af49c61e9b8142e749},
	affiliations = {University of Toronto, Department of Mechanical and Industrial Engineering, 5 King's College Road, Toronto, M5S 3G8, ON, Canada; Princess Margaret Cancer Centre, Radiation Medicine Program, 610 University Avenue, Toronto, M5G 2M9, ON, Canada},
	abstract = {Radiotherapy is a common treatment modality for the treatment of cancer, where treatments must be carefully designed to deliver appropriate dose to targets while avoiding healthy organs. The comprehensive multi-disciplinary quality assurance (QA) process in radiotherapy is designed to ensure safe and effective treatment plans are delivered to patients. However, the plan QA process is expensive, often time-intensive, and requires review of large quantities of complex data, potentially leading to human error in QA assessment. We therefore develop an automated machine learning algorithm to identify 'acceptable' plans (plans that are similar to historically approved plans) and 'unacceptable' plans (plans that are dissimilar to historically approved plans). This algorithm is a supervised extension of projective adaptive resonance theory, called SuPART, that learns a set of distinctive features, and considers deviations from them indications of unacceptable plans. We test SuPART on breast and prostate radiotherapy datasets from our institution, and find that SuPART outperforms common classification algorithms in several measures of accuracy. When no falsely approved plans are allowed, SuPART can correctly auto-approve 34% of the acceptable breast and 32% of the acceptable prostate plans, and can also correctly reject 53% of the unacceptable breast and 56% of the unacceptable prostate plans. Thus, usage of SuPART to aid in QA could potentially yield significant time savings. © 2022 Institute of Physics and Engineering in Medicine.},
	author_keywords = {adaptive resonance theory; anomaly detection; automation; machine learning; radiotherapy quality assurance},
	keywords = {Algorithms; Breast; Humans; Machine Learning; Male; Radiation Oncology; Vibration; Classification (of information); Learning algorithms; Machine learning; Quality assurance; Radiotherapy; Resonance; Urology; Adaptive resonance theory; Anomaly detection; Complex data; Plan quality; Quality assurance process; Radiotherapy quality assurance; Radiotherapy treatment; Resonance theory; Treatment modality; Treatment plans; algorithm; breast; human; machine learning; male; radiation oncology; vibration; Anomaly detection},
	correspondence_address = {D.M. Aleman; University of Toronto, Department of Mechanical and Industrial Engineering, Toronto, 5 King's College Road, M5S 3G8, Canada; email: aleman@mie.utoronto.ca},
	publisher = {IOP Publishing Ltd},
