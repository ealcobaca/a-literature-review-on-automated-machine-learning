	title = {Predictive lithology mapping using semisupervised learning: Practical insights using a case study from New South Wales, Australia},
	year = {2023},
	journal = {Geophysics},
	volume = {88},
	number = {3},
	doi = {10.1190/geo2022-0476.1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85148428477&doi=10.1190%2fgeo2022-0476.1&partnerID=40&md5=889a155c18aab559505c622cb1b58049},
	affiliations = {Memorial University of Newfoundland, Department of Earth Sciences, Newfoundland, St. John's, Canada; Department of Earth Sciences, Memorial University of Newfoundland, St. John's, A1B 3X5, NL, Canada},
	abstract = {We present a comprehensive study involving three different types of machine learning (unsupervised, supervised, and an emphasis on semisupervised) for bedrock-lithology classification using a publicly available dataset from New South Wales, Australia. The goal of this work is to demonstrate (1) the value each different type of machine learning can provide and (2) which machine learning type(s) may be preferable under different circumstances. Training data are characteristically limited for geoscience problems, which makes supervised techniques susceptible to overfitting; we explore if semisupervised methods can perform better in these circumstances. Using the geophysical data and geologic map provided for the study area, we compare the performance of two supervised methods (LightGBM and XGBoost) to one semisupervised algorithm (label propagation) in three scenarios with varied limited a priori lithologic constraints (i.e., the training data). Hyper-parameter tuning is an essential component of both supervised and semisupervised techniques, and the default procedure is to choose the hyper-parameter combination with the largest mean cross-validation score. However, we use a new hyper-parameter selection strategy that simultaneously uses the mean and standard deviation scores, and we test this new tactic for both supervised and semisupervised methods. The results show (i) that the new hyper-parameter selection technique can slightly improve the performance for both supervised and semisupervised methods by 1-2% compared to the standard selection approach, and (ii) that label propagation can outperform the two supervised methods by up to 10%, but it depends on how the training data are distributed. As for the unsupervised analysis, the clusters indicate heterogeneous regions that correlate well with high entropy areas in the supervised and semisupervised results. The clustering provides complementary results to the other two types of machine learning, and is a source of supporting evidence for suggesting where more in-depth field mapping may be needed.  © 2023 Society of Exploration Geophysicists.},
	author_keywords = {airborne survey; Australia; machine learning; mapping; mining},
	keywords = {Australia; New South Wales; Classification (of information); Lithology; Supervised learning; Airborne surveys; Australia; Hyper-parameter; Machine-learning; New South Wales; Performance; Semi-supervised; Semi-supervised method; Supervised methods; Training data; airborne survey; digital mapping; learning; lithology; machine learning; parameter estimation; standardization; training; Mapping},
	publisher = {Society of Exploration Geophysicists},
	issn = {00168033},
	coden = {GPYSA},
	language = {English},
	abbrev_source_title = {Geophysics},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Wang2022,
	author = {Wang, Qianyang and Zheng, Yuexin and Xu, Shugao and Zhou, Guihuan and Yu, Jingshan},
	title = {In situ mesoscale soil moisture content monitoring based on global navigation satellite system interferometric reflectometry and ensemble modeling},
	year = {2022},
	journal = {Journal of Applied Remote Sensing },
	volume = {16},
	number = {2},
	doi = {10.1117/1.JRS.16.024505},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206221141&doi=10.1117%2f1.JRS.16.024505&partnerID=40&md5=e4f249c65915384b0bc0a5bdc306629e},
	affiliations = {Beijing Normal University, College of Water Sciences, Beijing, China},
	abstract = {The existing point-scale or large-scale soil moisture content (SMC) monitoring techniques cannot entirely satisfy the requirements of in situ SMC monitoring for agricultural purposes. We proposed a framework for in situ mesoscale SMC monitoring based on global navigation satellite system interferometric reflectometry (GNSS-IR) and ensemble modeling technique. The framework consists of a data collecting and preparing system and an SMC retrieval system. The amplitude, phase, and detection depth, which are the GNSS-IR signal-to-noise ratio parameters, were positively and negatively correlated with the volumetric SMC data, respectively. In the SMC retrieval stage, five kinds of models including linear regression, multilinear regression, k-neighbor regressor, support vector regressor, and random forest (RF) was tested as the first-order model. Two kinds of swarm optimization algorithms including sparrow search algorithm (SSA) and particle swarm optimization (PSO) were examined for models' hyper-parameter optimization. The results show that the RF performed best and had a coefficient of determination (R2) of 0.798, a root mean square error (RMSE) of 0.043 cm3 / cm3, and a mean absolute error (MAE) of 0.034 cm3 / cm3 for the validation set. Both the SSA and PSO are effective for models' optimization. After input variable selection, the second-order ensemble RF model outperformed the first-order RF model and had an R2 of 0.819, an RMSE of 0.040 cm3 / cm3, and an MAE of 0.031 cm3 / cm3 for the validation set. The proposed framework is potentially valuable for popularization because of its cost-effectiveness and high accuracy.  © 2022 Society of Photo-Optical Instrumentation Engineers (SPIE).},
	author_keywords = {ensemble modeling; global navigation satellite system interferometric reflectometry; machine learning; mesoscale; soil moisture monitoring; swarm optimization},
	keywords = {Adaptive boosting; Dynamic programming; Error detection; Forward error correction; Global positioning system; Image coding; Image retrieval; Interpolation; Linear regression; Moisture meters; Network security; Random forests; Reflectometers; Soil moisture; Soil surveys; Support vector regression; Tropics; Ensemble models; Global navigation satellite system interferometric reflectometry; Global Navigation Satellite Systems; Interferometrics; Machine-learning; Meso scale; Reflectometry; Soil moisture content; Soil moisture monitoring; Swarm optimization; Particle swarm optimization (PSO)},
