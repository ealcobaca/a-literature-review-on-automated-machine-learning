	title = {Exploring the Impact of Learning Management System (LMS) Adoption on Online Learning: An Educator-Centric Perspective},
	year = {2024},
	journal = {Proceedings of 2024 2nd International Conference on Recent Trends in Microelectronics, Automation, Computing, and Communications Systems: Exploration and Blend of Emerging Technologies for Future Innovation, ICMACC 2024},
	pages = {87 – 92},
	doi = {10.1109/ICMACC62921.2024.10894691},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000387007&doi=10.1109%2fICMACC62921.2024.10894691&partnerID=40&md5=652b37b4f4868e703e0729a1ec50b21d},
	affiliations = {Manipal University Jaipur, Jaipur, India},
	abstract = {Learning Management Systems (LMS) are used in the context of online learning and it has to be significant from the perspective of educators. It is crucial to comprehend how LMS adoption affects teaching methods, instructional strategies, and overall learning experiences as technology continues to transform educational environments. Utilizing a qualitative research approach, the study collects data from instructors who are actively involved in online learning through surveys and Think aloud observations. The primary objective of this research is to unravel the multifaceted implications of LMS adoption on the teaching profession. The paper addresses several key aspects, including the integration of LMS into pedagogical strategies, changes in teaching methodologies, and the perceived effectiveness of LMS in facilitating student engagement and comprehension. Special attention is given to the challenges and opportunities that emerge for educators as they navigate the complexities of incorporating LMS into their teaching repertoire. The findings of this study contribute to the existing body of knowledge by shedding light on the nuances of LMS adoption from a teacher-centric perspective. Common themes and patterns in teachers' experiences with LMS, such as the impact on workload, professional development needs, and the role of LMS in fostering collaborative learning environments is identified. Moreover, the alignment between teachers' expectations and the actual outcomes of LMS integration, offering insights into areas that may require further refinement or support is being done. © 2024 IEEE.},
	author_keywords = {collaborative learning; digital age; LMS; Online education; technological shift; think aloud},
	keywords = {Adversarial machine learning; Contrastive Learning; Federated learning; Transfer learning; Collaborative learning; Digital age; Learning management system; On-line education; Online learning; System adoption; Teachers'; Teaching methods; Technological shift; Think aloud; Collaborative learning},
