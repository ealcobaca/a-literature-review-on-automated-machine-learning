@ARTICLE{Lee2022,
	author = {Lee, Dasheng and Chen, Liyuan},
	title = {Sustainable Air-Conditioning Systems Enabled by Artificial Intelligence: Research Status, Enterprise Patent Analysis, and Future Prospects},
