	keywords = {Computer graphics; Computer vision; Deep learning; Learning systems; Artificial intelligence; Computer vision; Deep learning; Generative adversarial network; Machine-learning; Network models; Performance; Stanford; Training data; Transfer learning methods; Generative adversarial networks},
