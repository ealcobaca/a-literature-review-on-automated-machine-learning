	keywords = {Adult; Algorithms; Antidepressive Agents; Depressive Disorder; Diagnosis, Computer-Assisted; Female; Humans; Machine Learning; Male; Neuroimaging; Retrospective Studies; Treatment Outcome; antidepressant agent; algorithm; bipolar depression; human; machine learning; major depression; meta analysis; mood disorder; neuroimaging; neuromodulation; phenomenology; predictive validity; priority journal; psychotherapy; Review; systematic review; treatment outcome; treatment response; adult; algorithm; computer assisted diagnosis; depression; female; male; retrospective study},
