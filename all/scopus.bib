	journal = {Artificial Intelligence Review},
	volume = {57},
	number = {8},
	doi = {10.1007/s10462-024-10853-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199797604&doi=10.1007%2fs10462-024-10853-9&partnerID=40&md5=0040d3b2658b70c8379afbe4b85f541a},
	affiliations = {School of Electrical Engineering and Computer Science (EECS), University of Ottawa, 800 King Edward Avenue, Ottawa, K1N 6N5, ON, Canada; Telfer School of Management, University of Ottawa, 55 Laurier Avenue East, Ottawa, K1N 6N5, ON, Canada},
	abstract = {Lifelong Machine Learning (LML) denotes a scenario involving multiple sequential tasks, each accompanied by its respective dataset, in order to solve specific learning problems. In this context, the focus of LML techniques is on utilizing already acquired knowledge to adapt to new tasks efficiently. Essentially, LML concerns about facing new tasks while exploiting the knowledge previously gathered from earlier tasks not only to help in adapting to new tasks but also to enrich the understanding of past ones. By understanding this concept, one can better grasp one of the major obstacles in LML, known as Knowledge Transfer (KT). This systematic literature review aims to explore state-of-the-art KT techniques within LML and assess the evaluation metrics and commonly utilized datasets in this field, thereby keeping the LML research community updated with the latest developments. From an initial pool of 417 articles from four distinguished databases, 30 were deemed highly pertinent for the information extraction phase. The analysis recognizes four primary KT techniques: Replay, Regularization, Parameter Isolation, and Hybrid. This study delves into the characteristics of these techniques across both neural network (NN) and non-neural network (non-NN) frameworks, highlighting their distinct advantages that have captured researchers’ interest. It was found that the majority of the studies focused on supervised learning within an NN modelling framework, particularly employing Parameter Isolation and Hybrid for KT. The paper concludes by pinpointing research opportunities, including investigating non-NN models for Replay and exploring applications outside of computer vision (CV). © The Author(s) 2024.},
	author_keywords = {Continual learning; Knowledge transfer; Lifelong machine learning; Transfer learning},
	keywords = {Learning systems; Transfer learning; Continual learning; Knowledge transfer; Lifelong machine learning; Machine-learning; Neural network model; Neural-networks; Sequential task; Systematic literature review; Transfer learning; Transfer technique; Knowledge management},
	correspondence_address = {H.L. Viktor; School of Electrical Engineering and Computer Science (EECS), University of Ottawa, Ottawa, 800 King Edward Avenue, K1N 6N5, Canada; email: hviktor@uOttawa.ca; W. Michalowski; Telfer School of Management, University of Ottawa, Ottawa, 55 Laurier Avenue East, K1N 6N5, Canada; email: wojtek@telfer.uOttawa.ca},
