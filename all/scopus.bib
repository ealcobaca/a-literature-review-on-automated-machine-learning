@ARTICLE{Saxena2024497,
	author = {Saxena, Neha and Saxena, Priyanka and Veenadhari, S.},
	title = {Self-attention and Transfer Learning-Based Clinical Recommendation System for Health Care},
	year = {2024},
	journal = {Lecture Notes in Electrical Engineering},
	volume = {1146 LNEE},
	pages = {497 – 516},
	doi = {10.1007/978-981-97-0037-0_36},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203602375&doi=10.1007%2f978-981-97-0037-0_36&partnerID=40&md5=b65081ddd4fb897e89acd378723d19b8},
	affiliations = {Department of Computer Science Engineering, Rabindranath Tagore University, Madhya Pradesh, Bhopal, India},
	abstract = {The typical single-domain recommendation algorithm is constrained by the weak correlation between patients and disease, the issue of patient/disease cold start, and the fact that it only models item evaluations based on patients while excluding the review content. The healthcare recommendation system for clinical queries extracts patient/disease comment data from the supporting domain to address the sparse data issue in the target domain and boost recommendation precision. In this study, the self-attention mechanism and transfer learning are combined to create the clinical recommendation system (CRS-ST) which is proposed. The target domain and auxiliary domain knowledges are both fully integrated by CRS-ST, in contrast to prior methods. In order to model the patient’s preferences, a self-attention mechanism is first introduced. Next, information to increase the recommendation accuracy of another domain is introduced. Finally, the knowledge fusion module and the score prediction module integrate the information of the two domains to predict the score. Research on the PUB-Med clinical database reveals that, in comparison to the current healthcare recommendation models, the MAE and MSE values on the three separate healthcare datasets are increased by 8.4%, 13.2%, and 19.4%, respectively, and by 6.3%, 7.8%, and 5.6% in comparison to CRS-ST, which has higher MAE and MSE values. The self-attention mechanism’s efficiency and transfer learning’s benefits in reducing data sparsity and patient cold-start issues have been demonstrated in numerous trials. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2024.},
	author_keywords = {Clinical entity; Cross-domain; Health care; Recommender system; Self-attention; Transfer learning},
	keywords = {Adversarial machine learning; Domain Knowledge; Federated learning; Transfer learning; Attention mechanisms; Clinical entity; Cold-start; Cross-domain; Recommendation algorithms; Self-attention; Single domains; Target domain; Transfer learning; Weak correlation; Contrastive Learning},
	correspondence_address = {N. Saxena; Department of Computer Science Engineering, Rabindranath Tagore University, Bhopal, Madhya Pradesh, India; email: nehasaxena1582@gmail.com},
	editor = {Agrawal J. and Sharma S. and Shukla R.K. and Shieh C.-S.},
