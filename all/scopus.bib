	keywords = {artificial intelligence; brain blood volume; computer assisted tomography; convolutional neural network; deep learning; diagnostic test accuracy study; digital subtraction angiography; eye disease; fluorescence angiography; human; International Space Station; neurologic disease; NeuroOcular Syndrome; nonhuman; ophthalmology; optical coherence tomography; pathophysiology; retina blood vessel; retinal nerve fiber layer thickness; retinal thickness; Review; space flight},
	correspondence_address = {J. Ong; Department of Ophthalmology and Visual Sciences, University of Michigan Kellogg Eye Center, Ann Arbor, 48105, United States; email: ongjo@med.umich.edu},
