@ARTICLE{Jin2020,
	author = {Jin, Wei and Jia, Nan},
	title = {Learning Transferable Convolutional Proxy by SMI-Based Matching Technique},
	year = {2020},
	journal = {Shock and Vibration},
	volume = {2020},
	doi = {10.1155/2020/8873137},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85094824818&doi=10.1155%2f2020%2f8873137&partnerID=40&md5=813fe90e7bc20fe39a808f410e649bba},
	affiliations = {Beijing Academy of Science and Technology, Beijing, 100094, China; Beijing Institute of New Technology Applications, Beijing, 100094, China; School of Informatics and Cyber Security, People's Public Security University of China, Beijing, 100038, China},
	abstract = {Domain-transfer learning is a machine learning task to explore a source domain data set to help the learning problem in a target domain. Usually, the source domain has sufficient labeled data, while the target domain does not. In this paper, we propose a novel domain-transfer convolutional model by mapping a target domain data sample to a proxy in the source domain and applying a source domain model to the proxy for the purpose of prediction. In our framework, we firstly represent both source and target domains to feature vectors by two convolutional neural networks and then construct a proxy for each target domain sample in the source domain space. The proxy is supposed to be matched to the corresponding target domain sample convolutional representation vector well. To measure the matching quality, we proposed to maximize their squared-loss mutual information (SMI) between the proxy and target domain samples. We further develop a novel neural SMI estimator based on a parametric density ratio estimation function. Moreover, we also propose to minimize the classification error of both source domain samples and target domain proxies. The classification responses are also smoothened by manifolds of both the source domain and proxy space. By minimizing an objective function of SMI, classification error, and manifold regularization, we learn the convolutional networks of both source and target domains. In this way, the proxy of a target domain sample can be matched to the source domain data and thus benefits from the rich supervision information of the source domain. We design an iterative algorithm to update the parameters alternately and test it over benchmark data sets of abnormal behavior detection in video, Amazon product reviews sentiment analysis, etc. © 2020 Wei Jin and Nan Jia.},
	keywords = {Convolution; Iterative methods; Parameter estimation; Product design; Sentiment analysis; Transfer learning; Turing machines; Vector spaces; Abnormal behavior detections; Classification errors; Convolutional model; Convolutional networks; Density-ratio estimations; Iterative algorithm; Manifold regularizations; Objective functions; Convolutional neural networks},
	correspondence_address = {W. Jin; Beijing Academy of Science and Technology, Beijing, 100094, China; email: jinwei@bjast.ac.cn},
	publisher = {Hindawi Limited},
	issn = {10709622},
	coden = {SHVIE},
	language = {English},
	abbrev_source_title = {Shock Vib},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access, Gold Open Access}
