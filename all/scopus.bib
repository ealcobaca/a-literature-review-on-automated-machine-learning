	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213202107&doi=10.1016%2fB978-0-323-95359-7.00008-X&partnerID=40&md5=5c49f24e6f1a7443f0a3453d606a01df},
	affiliations = {Department of Pathology, University of Michigan, Ann Arbor, MI, United States; Department of Laboratory Medicine and Pathology, University of Washington, Seattle, WA, United States; Department of Pathology, University of Pittsburgh, Pittsburgh, PA, United States; Department of Laboratory Medicine and Pathology, Mayo Clinic, Rochester, MN, United States},
	abstract = {Artificial intelligence (AI) and machine learning have surged in recent years, with applications in almost every industry, including healthcare. AI can tackle a spectrum of medically oriented tasks previously only performed by physicians and allied health professionals, including automating manual workflows and improving diagnostic accuracy on histopathology slides. Recent trends, such as data augmentation, transfer learning, automated annotations, and unsupervised learning, are facilitating pathologists’ roles in algorithm development. Integration of AI-based systems into anatomic pathology (AP) practice requires full implementation of digital pathology, integration with information technology infrastructures, modification of laboratory/pathologist workflows, appropriate reimbursement/cost-offsetting models, and active participation of pathologists to encourage buy-in. Regulations providing oversight of AI are currently in development and, when instituted, should promote safe and effective use. This review addresses the challenges in AI development, deployment, and regulation that need to be overcome prior to its widespread adoption in AP. © 2025 Elsevier Inc. All rights reserved.},
	author_keywords = {AI deployment; AI discovery; Anatomic pathology; Artificial intelligence; Digital pathology; Laboratory regulation; Machine learning; Pathology informatics},
