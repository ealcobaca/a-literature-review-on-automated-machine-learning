@ARTICLE{Vahidnia2024608,
	author = {Vahidnia, Mohammad H.},
	title = {Empowering geoportals HCI with task-oriented chatbots through NLP and deep transfer learning},
	year = {2024},
	journal = {Big Earth Data},
	volume = {8},
	number = {4},
	pages = {608 – 648},
	doi = {10.1080/20964471.2024.2403166},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204283983&doi=10.1080%2f20964471.2024.2403166&partnerID=40&md5=f29dcaa60e8a5b242ba7aa4a443f7456},
	affiliations = {Center for Remote Sensing and GIS Research, Faculty of Earth Sciences, Shahid Beheshti University, Tehran, Iran},
	abstract = {In the past ten years, chatbot development has matured to become one of the most well-distinguished outcomes of artificial intelligence. Despite some criticism, Bing AI, ChatGPT and other natural language processing (NLP) products of similar nature are becoming more popular. The creation of chatbots can close several gaps in geographic information retrieval as well. This research introduces and successfully implements, for the first time, a model for integrating task-oriented chatbots into geoportals, with the goal of easing user requests, improving access to geospatial services, and fostering human-computer interactions (HCI). Additionally, it presents a novel recommendation solution for matching the most appropriate volunteer to the user’s geospatial needs based on expertise similarity, semantic similarity, and community feedback. The three categories of finding map services, discovering geoprocessing services, and volunteer expert recommendations were shown to be the most significant geoportal bot intents. Depending on the requirement, each intent additionally includes various entities such as time, place, description, skill, etc. The notion of deep transfer learning (DTL) was then put into practice by customizing a pre-trained BERT (Bidirectional Encoder Representations from Transformers) model for our particular aim and creating a task-oriented conversational agent. According to the results, effective intent classification and entity recognition in the geospatial domain could arise from this approach. We performed the training process with 200 sample data, 20% of which were utilized in a stratified manner for testing, and we obtained f1-scores of at least 0.75. Finally, a pilot Geoportal Chabot that combines crowdsourcing and conversational agents’ approaches was put into use and tested with success. In keeping with SDI technical purposes, the system might direct users to common geospatial web services, namely WMS and WPS, in addition to including natural language understanding (NLU) and natural language generation (NLG) capabilities. Result of user-centered evaluation indicated that the integration of a chatbot significantly reduces the average time required to access geospatial data and processing services by more than 50%. Notably, this effect is even more pronounced when locating an expert, with a fivefold decrease in the time required. Finally, overall user satisfaction rose from 86% to 94%. © 2024 The Author(s). Published by Taylor & Francis Group and Science Press on behalf of the International Society for Digital Earth, supported by the International Research Center of Big Data for Sustainable Development Goals.},
	author_keywords = {Conversational agent; deep learning; expert recommendation; toponym; volunteered geographic information (VGI)},
	keywords = {Atmospheric chemistry; Atmospheric radiation; Atmospheric spectra; Benchmarking; Classification (of information); Crowdsourcing; Deep learning; Fog; Metadata; Natural language processing systems; Recommender systems; Reviews; Semantics; Transfer learning; Tropics; Chatbots; Conversational agents; Deep learning; Expert recommendations; Geo-spatial; Geoportal; Task-oriented; Toponym; Volunteered geographic information; artificial intelligence; crowdsourcing; data processing; GIS; machine learning; spatial data; spatial planning; voluntary approach; Chatbots},
	correspondence_address = {M.H. Vahidnia; Center for Remote Sensing and GIS Research, Faculty of Earth Sciences, Shahid Beheshti University, Shahid Shahriari Square, Tehran, Evin, 1983969411, Iran; email: mh_vahidnia@sbu.ac.ir},
	publisher = {Taylor and Francis Ltd.},
