	correspondence_address = {M.A. Astorayme; Peruvian Life Cycle Assessment & Industrial Ecology Network (PELCAN), Department of Engineering, Pontificia Universidad Católica del Perú, San Miguel, Av. Universitaria 1801, Lima, 15074, Peru; email: m.astoraymev@pucp.edu.pe},
