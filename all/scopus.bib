@CONFERENCE{Divya2024190,
	author = {Divya, K.S. and Gireesan, Sanjay and Vani, K.J. and Sidharth Radeep, M. and Paul, Gripsy and Menon, Ragi R.},
	title = {Character Recognition from EEG Signals - Survey},
	year = {2024},
	journal = {5th International Conference on Electronics and Sustainable Communication Systems, ICESC 2024 - Proceedings},
	pages = {190 – 195},
	doi = {10.1109/ICESC60852.2024.10689920},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206600155&doi=10.1109%2fICESC60852.2024.10689920&partnerID=40&md5=0b0de26bd965ab24114c9186a7495874},
	affiliations = {Adi Shankara Institute of Engineering & Technology, Department of Cse, Kalady, India},
	abstract = {Electroencephalography signals (EEG) provide a window into human brain activity and cognitive states, enabling the development of brain-computer interfaces (BCIs) for communication and control. This research study presents a comprehensive overview of state-of-the-art algorithms for decoding EEG signals to recognize characters, words, emotions, and other mental states. Key techniques reviewed include deep learning models like convolutional neural networks (CNNs), recurrent neural networks (RNNs), autoencoders, as well as classical machine learning methods such as support vector machines (SVMs), linear discriminant analysis (LDA), and k-nearest neighbors (KNN). The survey analyzes core algorithms, implementations, advantages, and limitations across various recognition targets spanning English letters, Chinese characters, facial emotions, personality types, and more. Important aspects covered include EEG feature extraction approaches, classification models, fusion strategies, and factors influencing performance like the number of channels, trials, and subjects. Recognition accuracies achieved by current systems range from 70-99% for characters and emotions, though most works are limited to lab settings. This study highlights trends, open challenges, and future directions to make EEG-based BCIs practical. Key challenges discussed include improving signal reliability and robustness to noise/artifacts, developing personalized subject-specific models, enhancing portability and ergonomics through wearable sensors, boosting information transfer rates, and addressing security vulnerabilities. Promising research avenues encompass sensor fusion, transfer/active learning, brain network modeling, compressed sensing, encryption, and blockchain. Despite remarkable progress, considerable interdisciplinary efforts are needed to realize robust, secure, and user-friendly BCIs that can meaningfully impact assistive technologies and environments. This review comprehensively analyzes the state-of-the-art while identifying limitations and opportunities to inspire further research on developing advanced machine learning solutions to decode EEG for enhanced human-computer interaction.  © 2024 IEEE.},
	author_keywords = {BCI; CNN; KNN; LDA; RNN},
	keywords = {Assistive technology; Brain computer interface; Convolutional neural networks; Deep neural networks; Electrotherapeutics; Emotion Recognition; Image acquisition; Image coding; Image segmentation; Image texture; Image thinning; Recurrent neural networks; Transfer learning; Brain activity; Brain cognitive; Cognitive state; Communication and control; Convolutional neural network; Human brain; Linear discriminant analyze; Nearest-neighbour; Neural-networks; Research studies; Support vector machines},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-835037994-5},
	language = {English},
	abbrev_source_title = {Int. Conf. Electron. Sustain. Commun. Syst., ICESC - Proc.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; Conference name: 5th International Conference on Electronics and Sustainable Communication Systems, ICESC 2024; Conference date: 7 August 2024 through 9 August 2024; Conference code: 203021}
}

