	journal = {International Journal of Image and Graphics},
	doi = {10.1142/S0219467826500221},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202882890&doi=10.1142%2fS0219467826500221&partnerID=40&md5=c420d68969b838ec8029f78295ccaa49},
