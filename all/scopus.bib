	affiliations = {Department of Electrical and Electronics Engineering, Centro Universitário FEI, SP, Sao Bernardo do Campo, 09850-901, Brazil; Department of Computer Vision, Instituto de Pesquisas Eldorado, SP, Campinas, 13083-898, Brazil; Centre for Defence Engineering Research and Training, College of Science and Engineering, Flinders University, Tonsley, 5042, SA, Australia},
