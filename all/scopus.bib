@CONFERENCE{Hu202412,
	author = {Hu, Zhongyu and Liu, Qinghua},
	title = {Combining Transfer Learning and GAN for GPR Target Detection},
	year = {2024},
	journal = {2024 5th International Conference on Computer Engineering and Intelligent Control, ICCEIC 2024},
	pages = {12 – 16},
	doi = {10.1109/ICCEIC64099.2024.10775532},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215515042&doi=10.1109%2fICCEIC64099.2024.10775532&partnerID=40&md5=1b54a9d45a786803a901291d27c539c9},
	affiliations = {School of Information and Communication, Guilin University of Electronic Science and Technology, Guilin, China},
	abstract = {Using transfer learning to address the issue of the difficulties of obtaining real samples for Ground penetrating radar (GPR) involves a significant challenge: finding an appropriate pre-training dataset. Current approaches either overlook the significance of dataset similarity or have numerous drawbacks when gathering pre-training datasets. To overcome this issue, a GAN (Generative Adversarial Network)-based transfer learning approach is proposed. The method uses GAN to produce a simulated dataset that is very comparable to genuine GPR data, effectively overcoming the difficulty of acquiring pre-training datasets. Following that, a two-stage migration learning method is utilized to transfer the shared parameters learned from the simulated GPR data to the actual GPR dataset. The accuracy of target recognition was further increased by incorporating a residual convolutional neural network into the feature extraction network. Furthermore, to thoroughly investigate the extent to which dataset similarity influences the impact of transfer learning, the study built a similarity comparison model and confirmed the efficacy and caliber of the simulated GPR dataset. The technique of combining GAN and transfer learning is demonstrated through comparison studies to successfully raise the small-sample GPR target recognition accuracy.  © 2024 IEEE.},
	author_keywords = {Garget recognition; Generative adversarial network; Ground penetrating radar; Transfer learning},
	keywords = {Adversarial machine learning; Contrastive Learning; Convolutional neural networks; Federated learning; Gallium nitride; Geological surveys; Radar target recognition; Transfer learning; Adversarial networks; Garget recognition; Ground Penetrating Radar; Pre-training; Radar data; Radar datasets; Radar target detection; Target recognition; Training dataset; Transfer learning; Generative adversarial networks},
	correspondence_address = {Q. Liu; School of Information and Communication, Guilin University of Electronic Science and Technology, Guilin, China; email: qhliu@guet.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
