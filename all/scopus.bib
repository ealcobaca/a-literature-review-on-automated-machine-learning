@ARTICLE{Yanzhen2024,
	author = {Yanzhen, Ming and Song, Chen and Wanping, Li and Zufang, Yang and Wang, Alan},
	title = {Exploring approaches to tackle cross-domain challenges in brain medical image segmentation: a systematic review},
	year = {2024},
