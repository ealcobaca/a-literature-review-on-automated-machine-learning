@ARTICLE{Fake2024195,
	author = {Fake, Helen and Dabbagh, Nada},
	title = {The Personalized Learning Interaction Framework in Practice (PLIFs): Current Implementations According to Chief Learning Officers and Learning Leaders},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1150 LNNS},
	pages = {195 – 201},
	doi = {10.1007/978-3-031-72430-5_16},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206462501&doi=10.1007%2f978-3-031-72430-5_16&partnerID=40&md5=8b381f69221a524938bd990177088cba},
	affiliations = {George Mason University, Fairfax, VA, United States},
	abstract = {Emerging from multiple peer reviewed research studies, a foundational iterative Delphi study, and a recently published book, The Personalized Learning Interaction Framework (PLIF) offers a sustainable framework for Chief Learning Officers (CLOs) to develop personalized learning environments for Workforce Training and Development Programs [6, 8]. The framework, grounded by an iterative expert review of (n = 224) experts, posits that creating a sustainable personalized learning ecosystem involves cultivating a series of interactions to include learner to content, learner and other learners, learner to small groups, learner to mentor, coach, or AI coach, learner to community of practice or social network, and learner to internet of things. The research suggests that effective personalized learning programs support and facilitate these interactions between the learner and the outside world that go beyond the design of content and extend to the development and nurturing of productive and collaborative learning relationships and engagement with tools (e.g., sensors, chatbots, etc.). This paper represents data from a recent survey of Learning Leaders (n = 23) regarding their training and development priorities as well as what they currently offer in their existing training and development programs. Results suggest Learning Leaders value soft skills over hard skills, that many of the interactions enabled through the PLIF are already present in their existing training programs and implies that training programs still embrace traditional formats of dissemination which leaves practitioners and researchers room to test different approaches beyond the traditional classroom format. Future areas of research and implications are discussed. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
	author_keywords = {Lifelong Learning; Personalized Learning; Workforce Training and Development Programs},
	keywords = {Adversarial machine learning; Collaborative learning; Contrastive Learning; Personnel training; Self-supervised learning; Transfer learning; Development programmes; Interaction framework; Learning interactions; Life long learning; Personalized learning; Training and development; Training program; Workforce development; Workforce training; Workforce training and development program; Federated learning},
	correspondence_address = {H. Fake; George Mason University, Fairfax, United States; email: hfake@gmu.edu},
	editor = {Guralnick D. and Auer M.E. and Poce A.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {23673370},
	isbn = {978-303172429-9},
	language = {English},
	abbrev_source_title = {Lect. Notes Networks Syst.},
