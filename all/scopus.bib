	affiliations = {Applied AI and Data Science Unit, The Faculty of Engineering, The Maersk Mc-Kinney Møller Institute, University of Southern Denmark, Odense, Denmark; Centre for Clinical Artificial Intelligence, Odense University Hospital, Odense, Denmark; Department of Electronics and Communication Engineering, Delhi Technological University (DTU), Shahbad Daulatpur, New Delhi, 110042, India; Rutgers Robert Wood Johnson Medical School, Rutgers University, NJ, United States},
