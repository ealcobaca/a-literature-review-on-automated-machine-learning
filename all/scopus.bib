	publisher = {wiley},
	isbn = {978-139419770-5; 978-139419767-5},
	language = {English},
	abbrev_source_title = {Hum. Cancer Diagnosis and Detection Using Exascale Computing},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

