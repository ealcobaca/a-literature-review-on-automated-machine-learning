	journal = {Proceedings of SPIE - The International Society for Optical Engineering},
	volume = {13224},
	doi = {10.1117/12.3034916},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201966765&doi=10.1117%2f12.3034916&partnerID=40&md5=350ef90f90d5cd8d01417137355d5cfb},
	affiliations = {China State Construction International Investments(Zhejiang) Limited, Zhejiang, Hangzhou, 310000, China},
	abstract = {With the rapid urbanization in China, the construction of high-rise residential buildings has become increasingly vital. However, the increasing scale and depth of substructures in tall buildings have posed challenges in the excavation of deep foundation pits. The excavation of such deep foundation pits demands comprehensive monitoring and management to ensure structural stability and safety. This study aims to address the issue of foundation pit deformation prediction using machine learning methods.Traditional mechanics models and numerical analysis methods have demonstrated substantial errors in this context. Therefore, this paper reviews the applications of Gaussian processes, genetic algorithm-optimized BP neural networks, and Long Short-Term Memory (LSTM) networks in foundation pit deformation prediction. However, these methods exhibit limitations, such as the stationary assumption in Gaussian processes, high computational costs associated with genetic algorithms, and LSTM's limited performance with small datasets. To mitigate the challenges posed by limited monitoring data, this study introduces a transfer learning strategy based on the CNN-LSTM-Attention model. Validation results from practical case studies suggest that this strategy effectively enhances the accuracy of foundation pit deformation prediction, especially when dealing with limited data. © 2024 SPIE.},
	author_keywords = {CNN-LSTM-Attention Model; Foundation pit deformation prediction; Limited data; Machine learning; Transfer learning},
	keywords = {Gaussian distribution; Long short-term memory; Photons; Prediction models; Attention model; CNN-long short-term memory-attention model; Deep foundation pit; Deformation's predictions; Foundation pit deformation prediction; Foundation pits; Limited data; Machine-learning; Short term memory; Transfer learning; Tall buildings},
