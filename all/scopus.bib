@CONFERENCE{Singh2024,
	author = {Singh, Pritpal and Kumar, Rakesh and Gupta, Meenu and Obaid, Ahmed J.},
	title = {A Critical Analysis and Classification of Breast Cancer Using Histopathology Images},
	year = {2024},
	journal = {2024 International Conference on Knowledge Engineering and Communication Systems, ICKECS 2024},
	doi = {10.1109/ICKECS61492.2024.10617282},
