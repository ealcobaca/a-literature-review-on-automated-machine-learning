	year = {2024},
	journal = {10th International Conference on Advanced Computing and Communication Systems, ICACCS 2024},
	pages = {311 – 314},
	doi = {10.1109/ICACCS60874.2024.10717253},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208603579&doi=10.1109%2fICACCS60874.2024.10717253&partnerID=40&md5=7a789c2bc87d8ae6eab727740876fec3},
	affiliations = {School of Computer Science and Engineering, VIT-AP University, Guntur, Amaravati, 522237, India},
	abstract = {An Internet of Things (IoT) enabled System's device nodes are always linked over an unprotected public route, making the network as a whole vulnerable to several security threats such as data tampering, eavesdropping, and other related problems. Thus, healthcare network components are not the only targets of spyware or fraudulent software; cyberattacks aimed at manipulating the performance of IoT devices can potentially affect the devices themselves. Furthermore, private and sensitive information inside the Internet of Things is vulnerable to both passive and active assaults, such as data poisoning attacks, due to privacy concerns. These security and privacy issues can lead to inefficient resource utilization by the connected devices in the network and disrupt their normal communication flow, overall system integrity, and model effectiveness. Several research ideas have been made to integrate two or more technology developments, such as Artificial Intelligence, Machine Learning (ML), Deep Learning (DL), and blockchain, to enhance the safety and secure communication of IoT applications. This paper examined the secure transmission of data and the classification of IoT data using DL models aided by blockchain. © 2024 IEEE.},
	author_keywords = {Block Chain; Communication; Cyberattacks; Data Transmission; Deep Learning; Healthcare; Security; Transmission},
	keywords = {Differential privacy; Transfer learning; Block-chain; Cyber-attacks; Data classification; Data-transmission; Deep learning; Healthcare; Learning models; Secure data; Security; Security threats; Data integrity},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
