	year = {2023},
	journal = {2023 International Conference on Computer Communication and Informatics, ICCCI 2023},
	doi = {10.1109/ICCCI56745.2023.10128454},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163058644&doi=10.1109%2fICCCI56745.2023.10128454&partnerID=40&md5=3fb6d184c91ae6c2db095c3931f8e7cf},
	affiliations = {Chitkara University, Institute of Engineering and Technology Chitkara University, India; AI Lab, Ton Duc Thang University, Viet Nam; Ton Duc Thang University, Artificial Intelligence Laboratory, Faculty of Information Technology, Viet Nam; ITM SLS Baroda University, Deputy Provost, Gujarat, India},
