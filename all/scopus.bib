	keywords = {Machine learning; Sensory analysis; Sensory perception; Taxonomies; Additional key word and phrasesstrategic decision-making; Decision frame; Decision-making process; Decisions makings; Key words; Machine-learning; Operational decisions; Strategic decision making; Strategic decisions; Tactical decisions; Decision making},
