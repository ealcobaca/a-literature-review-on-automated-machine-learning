	year = {2024},
	journal = {2024 International Conference on Electrical, Electronics and Computing Technologies, ICEECT 2024},
	doi = {10.1109/ICEECT61758.2024.10739048},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85211183075&doi=10.1109%2fICEECT61758.2024.10739048&partnerID=40&md5=2cf0c9110577267a5dce67cc226ba47a},
	affiliations = {Galgotias University, Greater Noida, India; Maharishi Markandeshwar (Deemed to be University), Haryana, Ambala, India},
	abstract = {After buying a product, the majority of buyers don't leave reviews, ratings, or comments, which makes it difficult for any e-commerce site to function. If a business can forecast whether a customer will like or dislike a product, it can use that information to suggest other comparable products and make decisions about whether or not to sell a certain product. This study's main goal is to forecast customer happiness with a product, which may be done by projecting the review rating that a client will provide after making a purchase. Using our dataset, we evaluate each classifier's performance using hyper parameter tuning procedure. Grid Search CV method is used with five machine learning algorithms - Naive Bayes , Logistic Regression, Decision Tree, Random Forest and Gradient Boost Decision Tree (GBDT) to find the customer satisfaction. The results showed that, GBDT outperforms the rest of the model with highest accuracy of 86.57. While both random forest and logistic regression perform reasonably well, but GBDT is more resilient to outliers. © 2024 IEEE.},
	author_keywords = {classifier; customer satisfaction; Hyper parameter tuning; machine learning},
	keywords = {Customer satisfaction; Decision trees; Machine learning; Random forests; Sales; Customer experience; Customers' satisfaction; E-commerce sites; Hyper parameter tuning; Hyper-parameter; Logistics regressions; Machine-learning; Online shopping; Parameters tuning; Random forests; Logistic regression},
