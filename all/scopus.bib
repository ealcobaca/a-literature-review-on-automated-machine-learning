@ARTICLE{Lee20241662,
	author = {Lee, Kihoon and Chang, Yohan},
	title = {PRiSm: Policy Recommendation Systems in Cadastral Survey Using National Public Opinion Big Data},
	year = {2024},
	journal = {International Journal on Informatics Visualization},
	volume = {8},
	number = {3-2},
	pages = {1662 – 1670},
	doi = {10.62527/joiv.8.3-2.3023},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85211448312&doi=10.62527%2fjoiv.8.3-2.3023&partnerID=40&md5=8017a7415eb5a8b50b1098bb8c26c6f9},
	affiliations = {National Infrastructure & Geospatial Information Research Division, Korea Research Institute for Human Settlements, Sejong-si, South Korea},
	abstract = {Cadastral surveys are vital for assessing individual properties and generating national statistics. In South Korea, rapid territorial changes have exposed personal-level issues, while current systems limited public engagement capabilities have constrained policymaking. Although efforts have been made to bridge this gap, they have been hindered by the lack of an effective medium. This study introduces a novel framework, PRiSm (Policy Recommendation Systems in Cadastral Survey), which leverages National Public Opinion Big Data. We collected and analyzed two key data sources: 1) public opinion data from 2018 to 2023, which correlates strongly with cadastral resurveys across South Korea, and 2) content from 54 major news media outlets over the same period. The first data set represents bottom-up opinions at the individual level, while the second reflects top-down perspectives on national issues. The PRiSm system, developed in this study, utilizes Natural Language Processing (NLP) and advanced Machine Learning (ML) techniques, including Word2Vec and a Genetic Algorithm for hyperparameter optimization, to process over a thousand inquiries and news articles. Our results highlight how different groups engage in discussions shaped by their interests and concerns, revealing key sensitivities and recommending terms invaluable for stakeholders and policymakers. We anticipate that PRiSm will offer meaningful insights for the public and decision-makers. Additionally, with more advanced ML and/or Deep Learning algorithms, there is significant potential for further advancements in NLP within the PRiSm framework. © 2024, Politeknik Negeri Padang. All rights reserved.},
	author_keywords = {Cadastral survey; natural language processing; policy recommendation systems; prediction; public opinion big data},
	correspondence_address = {Y. Chang; National Infrastructure & Geospatial Information Research Division, Korea Research Institute for Human Settlements, Sejong-si, South Korea; email: ycanns@krihs.re.kr},
	publisher = {Politeknik Negeri Padang},
	issn = {25499904},
	language = {English},
	abbrev_source_title = {Int. J. Inform. Vis.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

