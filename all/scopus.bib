	language = {English},
	abbrev_source_title = {Proc. XLOOP: Annu. Workshop Large-Scale Exp.-Loop Comput., Held conjunction SC: Int. Conf. High Perform. Comput., Netw., Storage Anal.},
	type = {Conference paper},
