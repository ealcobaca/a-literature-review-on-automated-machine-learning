	year = {2024},
	journal = {Journal of Building Engineering},
	volume = {98},
	doi = {10.1016/j.jobe.2024.111486},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85211152703&doi=10.1016%2fj.jobe.2024.111486&partnerID=40&md5=d5e25f9d5da2838fbd9f5f3b0f604eca},
	affiliations = {Graduate Program in Architecture (PROARQ), Universidade Federal do Rio de Janeiro (UFRJ), RJ, Rio de Janeiro, CEP 21941-972, Brazil; Graduate Program in Civil Engineering (PROPEC), Universidade Federal de Ouro Preto (UFOP), MG, Ouro Preto, CEP 35402-163, Brazil; Instituto Federal de Educação, Ciência e Tecnologia de Minas Gerais (IFMG), MG, Santa Luzia, CEP 33115-390, Brazil; Graduate Program in Civil Engineering (PEC), Universidade Federal de Juiz de Fora (UFJF), MG, Juiz de Fora, CEP 36036-900, Brazil; Graduate Program in Architecture and City (PPGAC), Universidade Vila Velha, ES, Vila Velha, CEP 29102-920, Brazil},
	abstract = {More than a billion people globally lack affordable and safe housing, with the majority located in the Global South (GS). In these regions, climate change will persistently impact living conditions, reducing thermal comfort and escalating energy consumption. Within this context, this investigation conducts a Systematic Literature Review (SLR) on the use of building performance simulation (BPS) tools for climate adaptation and mitigation through future weather file predictions. By analyzing 47 documents, the study offers suggestions for policymakers and highlights areas that require further research. From policymakers’ perspective, standardized metrics can promote better industry understanding and be key indicators for investment funds support climate-resilient developments. Public policies should mitigate overheating risks by moving beyond one-size-fits-all social housing approaches and implement nationwide tools for robust building design. Moreover, real progress in resilience relies on integrating enhanced building design standards with occupant behavior. From an academic perspective, future research should conduct national-level assessments of diverse urban architectural typologies, incorporating new resilience metrics and combining Global and Regional Climate Models to develop ensemble future weather files. New studies should adopt optimization, machine learning, and transfer learning techniques while effectively exploring trade-off procedures. Additionally, Life Cycle Assessment (LCA) and Life Cycle Cost Analysis (LCCA) are indispensable tools for advancing decarbonization efforts and evaluating technology feasibility in the built environment. Lastly, this SLR synthesizes past scientific achievements and current research gaps, providing an understanding of resilience modeling for climate adaptation and mitigation while offering a practical guide for sustainable residential buildings in the GS. © 2024 Elsevier Ltd},
	author_keywords = {Building performance simulation; Climate change; Energy efficiency; Global south; Review; Sustainable building design; Thermal comfort},
	keywords = {Building design; Building performance simulations; Energy; Future weathers; Global south; Policy makers; Residential building; Sustainable building design; Systematic literature review; Thermal; Sustainable building},
	correspondence_address = {L.R. Caldas; Graduate Program in Architecture (PROARQ), Universidade Federal do Rio de Janeiro (UFRJ), Rio de Janeiro, RJ, CEP 21941-972, Brazil; email: lucas.caldas@fau.ufrj.br},
	publisher = {Elsevier Ltd},
	issn = {23527102},
	language = {English},
	abbrev_source_title = {J. Build. Eng.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Cárdenas-Rangel2024,
	author = {Cárdenas-Rangel, J. and Jaramillo-Ibarra, J. and Osma-Pinto, G.},
	title = {Restrictions and alternatives for the development data-based energy prediction models in buildings located in tropical climate: Literature review},
	year = {2024},
	journal = {Building and Environment},
	volume = {262},
	doi = {10.1016/j.buildenv.2024.111786},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85197035649&doi=10.1016%2fj.buildenv.2024.111786&partnerID=40&md5=77a2a5c87dd25cd316c0cc7f1c750596},
	affiliations = {Universidad Industrial de Santander, Bucaramanga, Colombia},
	abstract = {Abstract – Prediction of energy consumption in buildings is the process that allows estimating the amount of energy consumed in a specific future period. Typically, a predicted energy consumption value is obtained from a model that considers the buildings' thermo-energetic physics, data and machine learning algorithms, or a mixture of the two. Usually, in the tropical climate, predictions of energy consumption in buildings are obtained with computational tools that approximate the energy dynamics of buildings. This demands large amounts of data and expertise from the modeler. What makes it challenging to use frequently. Alternatively, the approach based on data and machine learning algorithms is recognized as a valuable tool to obtaining more simplified prediction models without the drawbacks mentioned above. This article aims to identify, through a literature review, the considerations that researchers interested in temperate climate should take into account when implementing data-based energy prediction models. Likewise, the restrictions inherent to the tropical climate and the alternatives to overcome them. Existing literature review studies on energy prediction provide recommendations for establishing new prediction models under considerations such as data sufficiency, robust prediction algorithms, data from monitoring, and the selection of climate and consumption as input characteristics. However, a generalized scarcity of data is evident under the tropical climate, which compromises the quality of prediction models and restricts the application of recommendations suitable for temperate climate. To address the lack of data in tropical climate, the literature proposes alternatives such as generalization of input information, use of hybrid data, transfer learning and feature selection. © 2024 Elsevier Ltd},
