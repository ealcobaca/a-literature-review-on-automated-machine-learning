@CONFERENCE{Steve Arrul2022,
	author = {Steve Arrul, Vinscent and Subramanian, Preethi and Mafas, Raheem},
	title = {Predicting the Football Players' Market Value Using Neural Network Model: A Data-Driven Approach},
	year = {2022},
	journal = {IEEE International Conference on Distributed Computing and Electrical Circuits and Electronics, ICDCECE 2022},
	doi = {10.1109/ICDCECE53908.2022.9792681},
