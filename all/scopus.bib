	year = {2023},
	journal = {Algorithms},
	volume = {16},
	number = {1},
	doi = {10.3390/a16010046},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85146648912&doi=10.3390%2fa16010046&partnerID=40&md5=0130b7b505654a545b34ad5a38fed5c6},
	affiliations = {Department of Computer Control and Management Engineering, “Sapienza” University of Rome, Rome, 00100, Italy; Directorate for Data Collection, Italian National Institute of Statistics “Istat”, Rome, 00100, Italy},
	abstract = {User requests to a customer service, also known as tickets, are essentially short texts in natural language. They should be grouped by topic to be answered efficiently. The effectiveness increases if this semantic categorization becomes automatic. We pursue this goal by using text mining to extract the features from the tickets, and classification to perform the categorization. This is however a difficult multi-class problem, and the classification algorithm needs a suitable hyperparameter configuration to produce a practically useful categorization. As recently highlighted by several researchers, the selection of these hyperparameters is often the crucial aspect. Therefore, we propose to view the hyperparameter choice as a higher-level optimization problem where the hyperparameters are the decision variables and the objective is the predictive performance of the classifier. However, an explicit analytical model of this problem cannot be defined. Therefore, we propose to solve it as a black-box model by means of derivative-free optimization techniques. We conduct experiments on a relevant application: the categorization of the requests received by the Contact Center of the Italian National Statistics Institute (Istat). Results show that the proposed approach is able to effectively categorize the requests, and that its performance is increased by the proposed hyperparameter optimization. © 2023 by the authors.},
	author_keywords = {Auto ML; black-box optimization; classification; customer support; machine learning; statistical surveys},
	keywords = {Optimization; Semantics; Text processing; Auto ML; Automatic classification; Black-box optimization; Customer support; Customer-service; Hyper-parameter; Machine-learning; Natural languages; Short texts; Statistical survey; Machine learning},
