@ARTICLE{Akinrinade2022100,
	author = {Akinrinade, Olusoji B. and Du, Chunglin and Ajila, Samuel},
	title = {Using KullBack-Liebler Divergence Based Meta-learning Algorithm for Few-Shot Skin Cancer Image Classification: Literature Review and a Conceptual Framework},
	year = {2022},
	journal = {Communications in Computer and Information Science},
	volume = {1614 CCIS},
	pages = {100 – 111},
	doi = {10.1007/978-3-031-12641-3_9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85135935010&doi=10.1007%2f978-3-031-12641-3_9&partnerID=40&md5=539bb1bf93b9962a7407db1d67d5d5ae},
	affiliations = {Computer System Engineering Department, Tshwane University of Technology, Pretoria, South Africa; System and Computer Engineering Department, Carleton University, Ottawa, Canada},
	abstract = {Meta-learning often termed “learning to learn,” seeks to construct models that can swiftly learn new information or adapt to new situations using only a few training data samples. Meta-learning is distinct from traditional supervised learning. The model is required to recognise training data before generalising to unknown test data in traditional supervised learning. Meta-learning, on the other hand, has only one goal: to learn. Few-shot makes predictions based on a limited amount of data using a prototypical network that it learns using a metric space in which classification is done by computing distances between prototype representations of each class. The Kullback-Leibler Divergence (KLD) a non-symmetric distance measure between two probability distributions, p(x) and q(x) is used in the meta-learning process of few-shot leaning to compute the distance between the prototype class to query cancerous image. This study seeks to investigate the usefulness of KLD in cancer image classification to assist medical practitioner in early diagnosis of the dreadful disease. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
	author_keywords = {Artificial intelligence; Computing; Data; Few-shot meta learning; Images; Kullback-Liebler; Machine learning; Skin cancer},
	keywords = {Computer aided diagnosis; Dermatology; Diseases; Learning algorithms; Learning systems; Medical imaging; Probability distributions; Supervised learning; Computing; Data; Few-shot meta learning; Image; Images classification; Kullback-lieble; Learn+; Machine-learning; Metalearning; Skin cancers; Image classification},
