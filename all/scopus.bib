@CONFERENCE{Adhav202474,
	author = {Adhav, Savita and Sarpate, Ashish and Gaisamudre, Samrat and Tirmanwar, Sakshi and Ukey, Smitanshu},
	title = {Tackling the Emerging Threat of Image-Based Steganographic Malware with Advanced Machine Learning Techniques},
	year = {2024},
	journal = {Proceedings of the 5th International Conference on Data Intelligence and Cognitive Informatics, ICDICI 2024},
