@CONFERENCE{Surana2023,
	author = {Surana, Shraddha and Ambudkar, Shravan and Bihani, Prateek},
	title = {A comparative study on metric based meta learning approaches for few-shot image and text classification},
	year = {2023},
	journal = {AIP Conference Proceedings},
	volume = {2842},
	number = {1},
	doi = {10.1063/5.0175686},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85178254424&doi=10.1063%2f5.0175686&partnerID=40&md5=65af7482a173e4f40ea1e349d820cea6},
	affiliations = {ThoughtWorks Technologies, Pune, India; Symbiosis Skills and Professional University, Pune, India; Ekklavya Infosys, Pune, India},
	abstract = {Meta Learning is an old concept of cognitive psychology that can be defined as a method of learning to learn. Meta Learning intends to design models that can learn new skills or adapt to new environments rapidly by using the principles it learned during one task and applying them to the other tasks. Meta learning can be used as a tool in various machine learning domains such as transfer learning, few-shot learning, reinforcement learning, multitask learning, and hyperparameter optimization. In this comparative study, we explore and compare various metric based meta few-shot learning algorithms: Siamese Networks, Prototypical Networks, Matching Networks and Relation Networks for supervised image classification on MNIST, Fashion MNIST, omniglot and cifar-10 datasets as well as supervised text classification on 20 News, Amazon Review Sentiment Classification and Few Relation datasets. This study helps to identify the most suitable metric based meta few-shot learning approach for few-shot classification on an image and text dataset. Our analysis shows that Relation Networks and Prototypical Networks perform better as compared to Siamese Networks and Matching Networks for both images as well as text classification. © 2023 Author(s).},
	correspondence_address = {S. Surana; ThoughtWorks Technologies, Pune, India; email: shraddha.surana@gmail.com},
	editor = {Mishra B.K. and Kasturiwale H.P. and Alegavi S.},
	publisher = {American Institute of Physics Inc.},
	issn = {0094243X},
