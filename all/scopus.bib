@CONFERENCE{Zhao20247182,
	author = {Zhao, Angela and Chen, Tsute},
	title = {Detecting Depression in Children Through Machine Learning Using CatBoost and Random Forest Models},
	year = {2024},
	journal = {Proceedings - 2024 IEEE International Conference on Bioinformatics and Biomedicine, BIBM 2024},
	pages = {7182 – 7184},
	doi = {10.1109/BIBM62325.2024.10822618},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217276658&doi=10.1109%2fBIBM62325.2024.10822618&partnerID=40&md5=c86f020ea88bea7181d453145e18f217},
	affiliations = {Phillips Academy Andover, Andover, 01810, MA, United States; The Ada Forsyth Institute, Cambridge, 02142, MA, United States},
	abstract = {Depression, a prevalent yet often overlooked mood disorder, poses significant challenges in pediatric mental health due to subtle and variable symptom presentations across developmental stages. This study explores the potential of machine learning models - CatBoost and Random Forest - to detect depression in children using tabular data from the National Health Interview Survey (NHIS) (2019-2023). By leveraging consistent survey questions, particularly the DEPFREQ-C variable indicating the frequency of sadness or depression, the models classified children reporting 'Daily' as positive cases. The dataset was partitioned into 70-20-10 for training, validation, and testing sets. CatBoost and Random Forest were trained using distinct hyperparameter optimization methods, yielding maximum accuracies of 93.24% and 91.84%, respectively. Performance metrics, including precision, recall, and F1-score, highlight CatBoost's ability to handle categorical data and survey-specific variables. Additionally, analyses of pre- and post-COVID-19 data revealed minimal impact on model performance. While these models should only complement clinical diagnostics rather than replace them, these findings highlight the potential of machine learning in early-stage detection of depression among children. © 2024 IEEE.},
	author_keywords = {CatBoost; Children's Mental Health; Depression; Machine Learning; Random Forest},
	keywords = {Contrastive Learning; Pediatrics; Catboost; Child mental health; Depression; Developmental stage; Machine learning models; Machine-learning; Mental health; Mood disorders; Random forest modeling; Random forests; Adversarial machine learning},
