	publisher = {Frontiers Media SA},
	issn = {26248212},
	language = {English},
	abbrev_source_title = {Frontier. Artif. Intell.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 20; All Open Access, Gold Open Access, Green Open Access}
}

