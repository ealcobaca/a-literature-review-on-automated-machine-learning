	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85114273553&partnerID=40&md5=225a745659726a39f1a3484ede76a0c4},
	affiliations = {College of Engineering and Computer Science, Florida Atlantic University, Boca Raton, 33431, FL, United States},
	abstract = {Researchers experimenting with classification tasks for Machine Learning have a choice to use optimized or default values for their algorithms' hyperparameters. Our contribution is to conduct experiments with balanced and imbalanced datasets to show hyperparameter tuning has a significant, positive impact on classification results regardless of class ratio. To the best of our knowledge, this is the first study to investigate whether hyperparameter tuning has a statistically significant impact on the classification of balanced and imbalanced datasets derived from the Health and Retirement Study.We conduct a series of experiments with three classifiers, and five datasets. The classifiers are well-known, widely used classifiers in Machine Learning research. The datasets are based on a survey on cognition in human subjects. Three of the datasets are balanced, and two of them are imbalanced. We perform Analysis of Variance and Tukey's Honestly Significant Difference tests to determine the effect of hyperparameter tuning. Our results show that, regardless of class imbalance, using optimized hyperparameter values yields better results in a statistically significant sense. © 2021 Proceedings - 26th ISSAT International Conference on Reliability and Quality in Design, RQD 2021. All rights reserved.},
	author_keywords = {Anova; Catboost; Class imbalance; Cognition; Health and retirement study; Logistic regression; Machine learning; Random forest; Tukey hsd},
